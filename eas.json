{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8081",
        "EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN": "gaonpurecom-staging.firebaseapp.com",
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "gaonpurecom-staging"
      }
    },
    "staging": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://stage.gaonpure.com",
        "EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN": "gaonpurecom-staging.firebaseapp.com",
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "gaonpurecom-staging",
        "EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET": "gaonpurecom-staging.appspot.com",
        "EXPO_PUBLIC_RAZORPAY_KEY_ID": "rzp_test_GaonPureStaging123"
      }
    },
    "staging-store": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://stage.gaonpure.com",
        "EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN": "gaonpurecom-staging.firebaseapp.com",
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "gaonpurecom-staging",
        "EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET": "gaonpurecom-staging.appspot.com",
        "EXPO_PUBLIC_RAZORPAY_KEY_ID": "rzp_test_GaonPureStaging123"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.gaonpure.com",
        "EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN": "gaonpurecom-prod.firebaseapp.com",
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "gaonpurecom-prod",
        "EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET": "gaonpurecom-prod.appspot.com"
      }
    }
  },
  "submit": {
    "staging-store": {
      "android": {
        "track": "internal"
      }
    },
    "production": {
      "android": {
        "track": "production"
      }
    }
  }
}
